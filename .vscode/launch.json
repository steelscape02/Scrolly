{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Debug STM32 (OpenOCD) [Linux]",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
      "cwd": "${workspaceFolder}",
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/.vscode/STM32L476.svd",
      "preLaunchTask": "CMake: build",
      "serverpath": "/usr/bin/openocd",
      "gdbPath": "/usr/local/bin/arm-none-eabi-gdb",
      "configFiles": [
        "/usr/share/openocd/scripts/interface/stlink.cfg",
        "/usr/share/openocd/scripts/target/stm32l4x.cfg"
      ]
    },
    {
      "name": "Debug STM32 (OpenOCD) [Windows]",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
      "cwd": "${workspaceFolder}",
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/.vscode/STM32L476.svd",
      "preLaunchTask": "CMake: build",
      "serverpath": "C:/openocd/bin/openocd.exe",
      "configFiles": [
        "C:/openocd/bin/scripts/interface/stlink.cfg",
        "C:/openocd/bin/scripts/target/stm32l4x.cfg"
      ]
    },
    {
      "name": "Debug STM32 (ST-LINK)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/Scrolly.elf",
      "device": "STM32L476RG",
      "interface": "swd",
      "runToEntryPoint": "main",
      "serverpath": "C:/ST/STM32CubeIDE_2.1.1/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.stlink-gdb-server.win32_2.2.500.202604010938/tools/bin/ST-LINK_gdbserver.exe",
      "gdbPath": "C:/ST/STM32CubeCLT_1.22.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe"
    }
  ]
}