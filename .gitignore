# ==========================================
# STM32CubeIDE Build & Target Artifacts
# ==========================================
# Exclude build output folders (Debug, Release, custom configs)
[Dd]ebug/
[Rr]elease/
[Bb]uild/

# Binary files generated by the compiler
*.elf
*.bin
*.hex
*.map
*.o
*.obj
*.d
*.su
*.cyclomatic

# ==========================================
# STM32CubeIDE / Eclipse Project Settings
# ==========================================
# Toolchain & IDE auto-generated internal state
.settings/
.metadata/

# Optional: Ignore backup versions of Eclipse metadata
.cproject.bak
.project.bak

# Workspace or project index files
.launch
.pdm
*.launch

# Eclipse indexer & target cache
.target
.cproject.bak
.project.bak

# ==========================================
# STM32CubeMX Code Generator Artifacts
# ==========================================
# Auto-backup files created by CubeMX during updates
*.bak
*_backup.*
*.tmp

# CubeMX workspace auto-saves / logs
.mxproject.bak

# ==========================================
# System & Editor Junk
# ==========================================
.DS_Store
Thumbs.db
*~

#templates
docs/adr/adr_template.md